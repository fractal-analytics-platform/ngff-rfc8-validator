{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "node.schema",
  "title": "Node",
  "description": "OME Node",
  "type": "object",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "collection"
          }
        }
      },
      "then": {
        "$ref": "collection.schema"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "multiscale"
          }
        }
      },
      "then": {
        "$ref": "multiscale.schema"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "singlescale"
          }
        }
      },
      "then": {
        "$ref": "singlescale.schema"
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "type": "string",
            "not": {
              "anyOf": [
                {
                  "const": "collection"
                },
                {
                  "const": "singlescale"
                },
                {
                  "const": "multiscale"
                }
              ]
            }
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": {
              "$ref": "node.schema"
            }
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9-_.]+$"
    },
    "name": {
      "type": "string"
    }
  },
  "required": [
    "type",
    "name"
  ]
}